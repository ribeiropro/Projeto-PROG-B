
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts", "migrate.ts"],
  "exclude": ["node_modules", "dist"]
}
